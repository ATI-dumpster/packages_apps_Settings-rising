<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:paddingStart="?android:listPreferredItemPaddingEnd"
    android:paddingEnd="?android:listPreferredItemPaddingEnd">

    <androidx.cardview.widget.CardView
        android:id="@+id/base_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/fixed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/user_crd_bg"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:minHeight="?android:listPreferredItemHeightSmall"
                android:paddingStart="?android:listPreferredItemPaddingStart"
                android:paddingEnd="?android:listPreferredItemPaddingEnd"
                app:layout_constraintTop_toTopOf="parent">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@android:id/icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="start|center"
                        android:layout_marginEnd="16dp"
                        android:gravity="start"
                        android:src="@drawable/ic_rising"
                        android:tint="?android:textColorPrimary" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@android:id/icon"
                        android:ellipsize="marquee"
                        android:maxLines="2"
                        android:text="@string/afterlife_maintainer"
                        android:textAppearance="?android:textAppearanceListItem" />

                    <TextView
                        android:id="@+id/maintainer_name"
                        style="@style/PreferenceSummaryTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/title"
                        android:layout_alignStart="@+id/title"
                        android:layout_gravity="start"
                        android:layout_toEndOf="@android:id/icon"
                        android:maxLines="10"
                        android:textAlignment="viewStart"
                        android:textColor="?android:textColorSecondary" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="end|center"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp">

                    <ImageView
                        android:id="@+id/expand_button"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_expand"
                        android:tint="?android:textColorPrimary" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/hidden_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/user_crd_bg"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/fixed_layout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.android.settings.utils.CircularImageView
                                android:id="@+id/mProfile"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="start|center"
                                android:src="@drawable/maintainer_img"
                                app:civ_border="true"
                                app:civ_border_color="@*android:color/accent_device_default_light"
                                app:civ_border_width="0.5dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start|center"
                                android:gravity="start|center"
                                android:orientation="vertical"
                                android:paddingStart="16dp">

                                <TextView
                                    android:textAppearance="?android:textAppearanceLarge"
                                    android:textSize="36.0sp"
                                    android:textStyle="bold"
                                    android:layout_gravity="start|center"
                                    android:id="@+id/maintainer_name_expanded"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16.0dip"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:id="@+id/github"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="5dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/al_bg_single"
                                        android:backgroundTint="?android:colorBackgroundFloating"
                                        android:orientation="vertical"
                                        android:padding="10dp">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/github"
                                            android:tint="?android:colorAccent" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="Github"
                                            android:textAppearance="?android:textAppearanceListItemSmall"
                                            android:textSize="12sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/telegram"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginHorizontal="5dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/al_bg_single"
                                        android:backgroundTint="?android:colorBackgroundFloating"
                                        android:orientation="vertical"
                                        android:padding="10dp">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/telegram"
                                            android:tint="?android:colorAccent" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="Telegram"
                                            android:textAppearance="?android:textAppearanceListItemSmall"
                                            android:textSize="12sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/instagram"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/al_bg_single"
                                        android:backgroundTint="?android:colorBackgroundFloating"
                                        android:orientation="vertical"
                                        android:padding="10dp">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/instagram"
                                            android:tint="?android:colorAccent" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="Instagram"
                                            android:textAppearance="?android:textAppearanceListItemSmall"
                                            android:textSize="12sp" />

                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
